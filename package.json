{
  "name": "intranet-gcmp",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Intranet institucional da Guarda Civil Municipal de Passos",
  "main": "hostinger.cjs",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node hostinger.cjs",
    "check": "node --check server.js && node --check src/app.js",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mysql2": "^3.24.2",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2"
  }
}
